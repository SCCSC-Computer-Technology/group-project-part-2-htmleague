@page
@model TeamsNFLModel
@{
    ViewData["Title"] = "NFL Teams";

    // Get sort direction
    string GetSortDirection(string column)
    {
        if (Model.SortColumn == column)
        {
            if (Model.SortDirection == "Ascending")
            {
                return "Descending";
            }
            else
            {
                return "Ascending";
            }
        }
        else
        {
            return "Ascending";
        }
    }

    // Get sort indicator
    string GetSortIndicator(string column)
    {
        if (Model.SortColumn == column)
        {
            if (Model.SortDirection == "Ascending")
            {
                return "▲";
            }
            else
            {
                return "▼";
            }
        }
        else
        {
            return "";
        }
    }
}

<h2>NFL Teams</h2>

<table class="team-table">
    <thead>
        <tr>
            <th>
                <a asp-page="./NFL" asp-route-sortColumn="Name"
                   asp-route-sortDirection="@GetSortDirection("Name")">
                    Team @GetSortIndicator("Name")
                </a>
            </th>
            <th>
                <a asp-page="./NFL" asp-route-sortColumn="Wins"
                   asp-route-sortDirection="@GetSortDirection("Wins")">
                    Wins @GetSortIndicator("Wins")
                </a>
            </th>
            <th>
                <a asp-page="./NFL" asp-route-sortColumn="Losses"
                   asp-route-sortDirection="@GetSortDirection("Losses")">
                    Losses @GetSortIndicator("Losses")
                </a>
            </th>
            <th>
                <a asp-page="./NFL" asp-route-sortColumn="Ties"
                   asp-route-sortDirection="@GetSortDirection("Ties")">
                    Ties @GetSortIndicator("Ties")
                </a>
            </th>
            <th>
                <a asp-page="./NFL" asp-route-sortColumn="Touchdowns"
                   asp-route-sortDirection="@GetSortDirection("Touchdowns")">
                    Touchdowns @GetSortIndicator("Touchdowns")
                </a>
            </th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Teams != null)
        {
            foreach (var team in Model.Teams)
            {
                <tr>
                    <td>
                        <a asp-page="/Statistics/Team"
                           asp-route-id="@team.Team?.TeamID"
                           asp-route-sport="NFL">
                            @team.Team?.TeamName
                        </a>
                    </td>
                    <td>@team.Wins</td>
                    <td>@team.Losses</td>
                    <td>@team.Ties</td>
                    <td>@team.TotalTD</td>
                </tr>
            }
        }
    </tbody>
</table>

<style>
    .tabs {
        margin-bottom: 20px;
    }

    .tab {
        display: inline-block;
        padding: 10px 20px;
        background: #e0f0e9;
        margin-right: 5px;
        border-radius: 5px;
        text-decoration: none;
        font-weight: bold;
    }

    .selected {
        background: #27ae60;
        color: white;
    }

    .team-table {
        width: 100%;
        border-collapse: collapse;
        background: white;
    }

        .team-table th, .team-table td {
            padding: 10px;
            border: 1px solid #ccc;
        }

        .team-table th {
            background: #2ecc71;
            color: white;
        }

            .team-table th a {
                color: white;
                text-decoration: none;
                display: block;
            }

                .team-table th a:hover {
                    text-decoration: underline;
                }
</style>