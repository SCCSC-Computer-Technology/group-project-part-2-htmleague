@page
@model TeamsCSGOModel
@{
    ViewData["Title"] = "CS:GO Teams";
}

@*CSGO (Counter-Strike: Global Offensive) background image page*@
<style>
    body {
        background-image: url('images/CSGO-background 4.jpg');
        background-repeat: no-repeat;
        background-attachment: fixed;
        background-size: cover;
    }
</style>

<h2>CS:GO Teams</h2>

<table class="team-table">
    <thead>
        <tr>
            <th>Team</th>
            <th>Maps Played</th>
            <th>K/D Diff</th>
            <th>K/D Ratio</th>
            <th>Rating</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Teams != null)
        {
            foreach (var team in Model.Teams)
            {
                <tr>
                    <td>@team.Team?.TeamName</td>
                    <td>@team.TotalMaps</td>
                    <td>@team.KdDiff</td>
                    <td>@team.Kd</td>
                    <td>@team.Rating</td>
                </tr>
            }
        }
    </tbody>
</table>


<style>
    .tabs {
        margin-bottom: 20px;
    }
    .tab {
        display: inline-block;
        padding: 10px 20px;
        background: #e0f0e9;
        margin-right: 5px;
        border-radius: 5px;
        text-decoration: none;
        font-weight: bold;
    }
    .selected {
        background: #27ae60;
        color: white;
    }
    .team-table {
        width: 100%;
        border-collapse: collapse;
        background: white;
    }
    .team-table th, .team-table td {
        padding: 10px;
        border: 1px solid #ccc;
    }
    .team-table th {
        background: #2ecc71;
        color: white;
    }
</style>
