@page
@model HTMLeague_WebApplication.Pages.Players.PlayersNBAModel
@{
    ViewData["Title"] = "NBA Players";

    // Get sort direction
    string GetSortDirection(string column)
    {
        if (Model.SortColumn == column)
        {
            if (Model.SortDirection == "Ascending")
            {
                return "Descending";
            }
            else
            {
                return "Ascending";
            }
        }
        else
        {
            return "Ascending";
        }
    }

    // Get sort indicator
    string GetSortIndicator(string column)
    {
        if (Model.SortColumn == column)
        {
            if (Model.SortDirection == "Ascending")
            {
                return "▲";
            }
            else
            {
                return "▼";
            }
        }
        else
        {
            return "";
        }
    }
}

<h2>NBA Players</h2>

<table class="team-table">
    <thead>
        <tr>
            <th>
                <a asp-page="./NBA" asp-route-sortColumn="Name"
                   asp-route-sortDirection="@GetSortDirection("Name")">
                    Player Name @GetSortIndicator("Name")
                </a>
            </th>
            <th>
                <a asp-page="./NBA" asp-route-sortColumn="TeamName"
                   asp-route-sortDirection="@GetSortDirection("TeamName")">
                    Team @GetSortIndicator("TeamName")
                </a>
            </th>
            <th>
                <a asp-page="./NBA" asp-route-sortColumn="Points"
                   asp-route-sortDirection="@GetSortDirection("Points")">
                    Points @GetSortIndicator("Points")
                </a>
            </th>
            <th>
                <a asp-page="./NBA" asp-route-sortColumn="Assists"
                   asp-route-sortDirection="@GetSortDirection("Assists")">
                    Assists @GetSortIndicator("Assists")
                </a>
            </th>
            <th>
                <a asp-page="./NBA" asp-route-sortColumn="Rebounds"
                   asp-route-sortDirection="@GetSortDirection("Rebounds")">
                    Rebounds @GetSortIndicator("Rebounds")
                </a>
            </th>
            <th>
                <a asp-page="./NBA" asp-route-sortColumn="FieldGoals"
                   asp-route-sortDirection="@GetSortDirection("FieldGoals")">
                    Field Goals @GetSortIndicator("FieldGoals")
                </a>
            </th>
            <th>
                <a asp-page="./NBA" asp-route-sortColumn="ThreePoints"
                   asp-route-sortDirection="@GetSortDirection("ThreePoints")">
                    3 Points @GetSortIndicator("ThreePoints")
                </a>
            </th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Players != null)
        {
            foreach (var player in Model.Players)
            {
                <tr>
                    <td>
                        <a asp-page="/Statistics/Player"
                           asp-route-id="@player.Player?.PlayerID"
                           asp-route-sport="NBA">
                            @player.Player?.FullName
                        </a>
                    </td>
                    <td>
                        <a asp-page="/Statistics/Team"
                           asp-route-id="@player.Player?.TeamID"
                           asp-route-sport="NBA">
                            @player.TeamName
                        </a>
                    </td>
                    <td>@(player.Stats?.TotalPoints ?? 0)</td>
                    <td>@(player.Stats?.Assists ?? 0)</td>
                    <td>@(player.Stats?.OffensiveRebounds ?? 0)</td>
                    <td>@(player.Stats?.FieldGoals ?? 0)</td>
                    <td>@(player.Stats?.ThreePoints ?? 0)</td>
                </tr>
            }
        }
    </tbody>
</table>

<style>
    .tabs {
        margin-bottom: 20px;
    }

    .tab {
        display: inline-block;
        padding: 10px 20px;
        background: #e0f0e9;
        margin-right: 5px;
        border-radius: 5px;
        text-decoration: none;
        font-weight: bold;
    }

    .selected {
        background: #27ae60;
        color: white;
    }

    .team-table {
        width: 100%;
        border-collapse: collapse;
        background: white;
    }

        .team-table th, .team-table td {
            padding: 10px;
            border: 1px solid #ccc;
        }

        .team-table th {
            background: #2ecc71;
            color: white;
        }

            .team-table th a {
                color: white;
                text-decoration: none;
                display: block;
            }

                .team-table th a:hover {
                    text-decoration: underline;
                }
</style>