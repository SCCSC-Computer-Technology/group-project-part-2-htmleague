@page
@model TeamsNBAModel
@{
    ViewData["Title"] = "NBA Teams";
}

<h2>NBA Teams</h2>

<table class="team-table">
    <thead>
        <tr>
            <th>Team</th>
            <th>Field Goals</th>
            <th>Assists</th>
            <th>Total Points</th>
            <th>3 Point Attempts</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Teams != null)
        {
            foreach (var team in Model.Teams)
            {
                <tr>
                    <td>@team.Team?.TeamName</td>
                    <td>@team.FieldGoals</td>
                    <td>@team.Assists</td>
                    <td>@team.TotalPoints</td>
                    <td>@team.ThreePointAttempts</td>
                </tr>
            }
        }
    </tbody>
</table>


<style>
    .tabs {
        margin-bottom: 20px;
    }
    .tab {
        display: inline-block;
        padding: 10px 20px;
        background: #e0f0e9;
        margin-right: 5px;
        border-radius: 5px;
        text-decoration: none;
        font-weight: bold;
    }
    .selected {
        background: #27ae60;
        color: white;
    }
    .team-table {
        width: 100%;
        border-collapse: collapse;
        background: white;
    }
    .team-table th, .team-table td {
        padding: 10px;
        border: 1px solid #ccc;
    }
    .team-table th {
        background: #2ecc71;
        color: white;
    }
</style>
